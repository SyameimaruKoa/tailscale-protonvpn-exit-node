# Tailscale: required at initial authentication only
TS_AUTHKEY=tskey-auth-your-key
# Optional; defaults to proton--<host hostname>
TS_HOSTNAME=

# Proton VPN (WireGuard is recommended). Paste the PrivateKey generated in:
# https://account.proton.me/u/0/vpn/WireGuard
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
# Copy the Address field of the same generated config, especially for IPv6.
WIREGUARD_ADDRESSES=10.2.0.2/32

# Only needed when VPN_TYPE=openvpn (Proton OpenVPN/IKEv2 credentials)
OPENVPN_USER=
OPENVPN_PASSWORD=
OPENVPN_PROTOCOL=udp

# Country names in English. Comma-separated values are allowed.
# Do not set a SERVER_HOSTNAMES filter: keep all eligible servers selectable.
SERVER_COUNTRIES=Japan
SERVER_REGIONS=
SERVER_CITIES=

# Gluetun / Proton VPN server category filters
FREE_ONLY=off
STREAM_ONLY=off
SECURE_CORE_ONLY=off
TOR_ONLY=off
PORT_FORWARD_ONLY=off

# Optional Proton port forwarding (requires a supporting plan/config/server).
VPN_PORT_FORWARDING=off

# Update Gluetun server data every 20 days. Keep >= 360h.
UPDATER_PERIOD=480h
DNS_UPSTREAM_RESOLVERS=cloudflare
TZ=Asia/Tokyo

# IPv6 egress is opt-in. See README; default safely blocks forwarded IPv6.
ENABLE_IPV6_EGRESS=false
VPN_INTERFACE=tun0
ROUTE_GUARD_INTERVAL=15
