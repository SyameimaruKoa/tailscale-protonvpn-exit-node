# 初回登録時の Tailscale 認証キー（登録後は保存した状態を使用）
TS_AUTHKEY=tskey-auth-your-key

# Proton VPN の WireGuard 設定ファイルにある [Interface] の PrivateKey
# https://account.proton.me/u/0/vpn/WireGuard
WIREGUARD_PRIVATE_KEY=

# 接続先の国（英語名、複数指定も可能）
SERVER_COUNTRIES=Japan

# 無料プラン向けに無料サーバーのみを初期選択する。
# 有料サーバーを使う場合は以下を有効化する。
# FREE_ONLY=off
#
# IPv6はProton VPNの対応サーバーで使用できます。
# OpenVPN・地域指定・Secure Core などの詳細設定は README を参照。
